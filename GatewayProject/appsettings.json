{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {

      "categories-route": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/categories/{**match-all}"
        }

      },

      "course-route": {

        "ClusterId": "Courses-cluster",
        "Match": {
          "Path": "/api/Courses/{**match-all}"
        }

      }


    },

    "Clusters": {

      "categories-cluster": {
        "Destinations": {
          "Courses-destination": {
            "Address": "http://categoriesService"
          }
        }
      },

      "Courses-cluster": {
        "Destinations": {
          "Courses-destionation": {
            "Address": "http://CoursesService"
          }
        }
      }

    }



  }









}

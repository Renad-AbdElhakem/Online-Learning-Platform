{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {

      "categories-route": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/categories/{**match-all}"
        }

      },

      "course-route": {

        "ClusterId": "Courses-cluster",
        "Match": {
          "Path": "/api/Courses/{**match-all}"
        }

      },
      "instructorcourse-route": {

        "ClusterId": "Courses-cluster",
        "Match": {
          "Path": "/api/instructorCourses/{**match-all}"
        }

      },

      "instructor-route": {
        "ClusterId": "instructor-cluster",
        "Match": {
          "Path": "/api/instructor/{**match-all}"
        }

      },

      "group-route": {
        "ClusterId": "group-cluster",
        "Match": {
          "Path": "/api/Groups/{**match-all}"
        }

      },

      "Enrollment-route": {
        "ClusterId": "group-cluster",
        "Match": {
          "Path": "/api/enrollment/{**match-all}"
        }
      },

      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/Student/{**match-all}"
        }
      },
      "ContentGroup-route": {
        "ClusterId": "contentgroup-cluster",
        "Match": {
          "Path": "/api/lecture/{**match-all}"
        }
      },
      "Material-route": {
        "ClusterId": "contentgroup-cluster",
        "Match": {
          "Path": "/api/material/{**match-all}"
        }
      },
      "Assignment-route": {
        "ClusterId": "assignment-cluster",
        "Match": {
          "Path": "/api/assignment/{**match-all}"
        }
      },
      "StudentAssignment-route": {
        "ClusterId": "assignment-cluster",
        "Match": {
          "Path": "/api/studentassignment/{**match-all}"
        }
      }

    },

    "Clusters": {

      "categories-cluster": {
        "Destinations": {
          "Courses-destination": {
            "Address": "http://categoriesService"
          }
        }
      },

      "Courses-cluster": {
        "Destinations": {
          "Courses-destination": {
            "Address": "http://CoursesService"
          }
        }
      },


      "instructor-cluster": {
        "Destinations": {
          "instructor-destination": {
            "Address": "http://InstructorService"
          }
        }
      },

      "groups-cluster": {
        "Destinations": {
          "groups-destination": {
            "Address": "http://GroupsService"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student-destination": {
            "Address": "http://StudentService"
          }

        }
      },
      "contentgroup-cluster": {
        "Destinations": {
          "contentgroup-destination": {
            "Address": "http://ContentService"
          }

        }
      },
      "assignment-cluster": {
        "Destinations": {
          "assignment-destination": {
            "Address": "http://AssignmentService"
          }

        }
      }

    }



  }









}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {

      "categories-route": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/categories/{**match-all}"
        },
        "RateLimiterPolicy": "Category-per-user",
        "AuthorizationPolicy": "default"

      },

      "course-route": {

        "ClusterId": "Courses-cluster",
        "Match": {
          "Path": "/api/Courses/{**match-all}"
        },
        "RateLimiterPolicy": "Course-per-user"
        

      },
      "instructorcourse-route": {

        "ClusterId": "Courses-cluster",
        "Match": {
          "Path": "/api/instructorCourses/{**match-all}"
        },
        "RateLimiterPolicy": "InstructorCourse-per-user"
     

      },

      "instructor-route": {

        "ClusterId": "instructor-cluster",
        "Match": {
          "Path": "/api/instructor/{**match-all}"
        },
        "RateLimiterPolicy": "Instructor-per-user"


      },

      "group-route": {
        "ClusterId": "group-cluster",
        "Match": {
          "Path": "/api/Groups/{**match-all}"
        },
        "RateLimiterPolicy": "Group-per-user"

      },

      "Enrollment-route": {
        "ClusterId": "group-cluster",
        "Match": {
          "Path": "/api/enrollment/{**match-all}"
        },
        "RateLimiterPolicy": "Enrollment-per-user"
      },

      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/Student/{**match-all}"
        },
        "RateLimiterPolicy": "Student-per-user"
      },


      "ContentGroup-route": {
        "ClusterId": "contentgroup-cluster",
        "Match": {
          "Path": "/api/lecture/{**match-all}"
        },
        "RateLimiterPolicy": "Lecture-per-user"
      },


      "Material-route": {
        "ClusterId": "contentgroup-cluster",
        "Match": {
          "Path": "/api/material/{**match-all}"
        },
        "RateLimiterPolicy": "Material-per-user"
      },



      "Assignment-route": {
        "ClusterId": "assignment-cluster",
        "Match": {
          "Path": "/api/assignment/{**match-all}"
        },
        "RateLimiterPolicy": "Assignment-per-user"
      },

      "StudentAssignment-route": {
        "ClusterId": "assignment-cluster",
        "Match": {
          "Path": "/api/studentassignment/{**match-all}"
        },
        "RateLimiterPolicy": "StudentAssignment-per-user"
      },
      "UserAuth-route": {
        "ClusterId": "Auth-cluster",
        "Match": {
          "Path": "/api/UserAuth/{**match-all}"
        },
        "RateLimiterPolicy": "UserAuth-per-user"
      },

      "Role-route": {
        "ClusterId": "Auth-cluster",
        "Match": {
          "Path": "/api/roles/{**match-all}"
        },
        "RateLimiterPolicy": "Role-per-user"

      }

    },





    "Clusters": {

      "categories-cluster": {
        "Destinations": {
          "Courses-destination": {
            "Address": "categoriesService"
          }
        }
      },

      "Courses-cluster": {
        "Destinations": {
          "Courses-destination": {
            "Address": "CoursesService"
          }
        }
      },


      "instructor-cluster": {
        "Destinations": {
          "instructor-destination": {
            "Address": "InstructorService"
          }
        }
      },

      "group-cluster": {
        "Destinations": {
          "groups-destination": {
            "Address": "GroupsService"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student-destination": {
            "Address": "StudentService"
          }

        }
      },
      "contentgroup-cluster": {
        "Destinations": {
          "contentgroup-destination": {
            "Address": "ContentService"
          }

        }
      },
      "assignment-cluster": {
        "Destinations": {
          "assignment-destination": {
            "Address": "AssignmentService"
          }

        }
      },

      "Auth-cluster": {
        
        "Destinations": {
          "auth-destination": {
            "Address": "AuthService"
          }

        }
      }

    }



  }









}
